"""
Android Automotive Software Defined Vehicle Metrics Configuration Generator
"""

module(
    name = "com_googlesource_sdv_mcg",
    version = "1.4.0",
)

bazel_dep(
    name = "container_structure_test",
    version = "1.19.1",
)
bazel_dep(
    name = "gazelle",
    version = "0.44.0",
)
bazel_dep(
    name = "googleapis",
    version = "0.0.0-20241220-5e258e33",
)
bazel_dep(
    name = "googleapis-go",
    version = "1.0.0",
)
bazel_dep(
    name = "rules_go",
    version = "0.59.0",
)

# TODO: b/440287458 - For now, we manually apply
# github.com/bazel-contrib/rules_go/pull/4401, since it is not yet merged
# upstream.
single_version_override(
    module_name = "rules_go",
    patch_strip = 1,
    patches = [
        "rules_go_patch.diff",
    ],
)

bazel_dep(
    name = "rules_oci",
    version = "1.8.0",
)
bazel_dep(
    name = "rules_pkg",
    version = "1.1.0",
)
bazel_dep(
    name = "rules_proto",
    version = "7.1.0",
)
bazel_dep(
    name = "rules_python",
    version = "1.5.1",
)
bazel_dep(
    name = "rules_shellcheck",
    version = "0.3.3",
)
bazel_dep(
    name = "protobuf",
    version = "29.3",
    repo_name = "protobuf_src",
)
bazel_dep(
    name = "bazel_skylib",
    version = "1.8.1",
)
bazel_dep(
    name = "rules_shell",
    version = "0.5.0",
)
bazel_dep(
    name = "aspect_bazel_lib",
    version = "2.20.0",
)
bazel_dep(
    name = "jq.bzl",
    version = "0.1.0",
)
bazel_dep(
    name = "yq.bzl",
    version = "0.2.0",
)
bazel_dep(
    name = "rules_jvm_external",
    version = "6.8",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.openapitools:openapi-generator-cli:7.15.0",
    ],
    lock_file = "//:maven_install.json",
    strict_visibility = True,
)
use_repo(maven, "maven")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "swagger_ui",
    build_file_content = """
filegroup(
  name = "swagger_ui",
  srcs = glob(["**"], exclude=["swagger-initializer.js", "BUILD.bazel", "WORKSPACE"], allow_empty=False),
  visibility = ["//visibility:public"],
)
    """,
    sha256 = "15f1dc8c80663e5f2926818c1d8cf8ca5f97c4cbd494a90145c1e213d2c76dc3",
    strip_prefix = "swagger-ui-5.27.1/dist",
    url = "https://github.com/swagger-api/swagger-ui/archive/refs/tags/v5.27.1.zip",
)

# Allows to execute as root (required for Cloud Build)
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = False,
    ignore_root_user_error = True,
    python_version = "3.11",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.nogo(nogo = "//:my_nogo")
go_sdk.download(version = "1.25.4")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    # digest version 2026-05-27 of latest
    # TODO(b/316988911): Update the digest hash every 6 months.
    # Visit the gcr.io link, find the image tagged latest, and click copy hash, then strip it at the @ sign.
    digest = "sha256:58695f439f772a00009c8f6be4c183f824c1f556d74b313c30900f167e4772f8",
    image = "gcr.io/distroless/base-debian12",
    platforms = [
        "linux/amd64",
    ],
)
use_repo(oci, "distroless_base")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_bazelbuild_buildtools", "com_github_cenkalti_backoff", "com_github_gin_gonic_gin", "com_github_google_go_cmp", "com_github_google_uuid", "com_github_ory_dockertest", "com_github_protocolbuffers_txtpbfmt", "com_github_redis_go_redis_v9", "in_gopkg_yaml_v3", "org_golang_google_genproto_googleapis_rpc", "org_golang_google_protobuf")

bazel_lib = use_extension("@aspect_bazel_lib//lib:extensions.bzl", "toolchains")
bazel_lib.jq()
use_repo(bazel_lib, "jq_toolchains")
