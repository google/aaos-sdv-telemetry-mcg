load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_tarball")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_shellcheck//:def.bzl", "shellcheck_test")

pkg_tar(
    name = "tar_mcg",
    srcs = ["//:mcg"],
)

oci_image(
    name = "image_mcg",
    base = "@distroless_base",
    cmd = ["/mcg"],
    exposed_ports = ":exposed_ports",
    tars = [":tar_mcg"],
)

# This rule squashes the image for the test.
oci_tarball(
    name = "image_mcg_tarball",
    image = ":image_mcg",
    repo_tags = [],
)

container_structure_test(
    name = "test_image_mcg",
    size = "small",
    configs = [
        "structure-test.yaml",
    ],
    driver = "tar",
    image = ":image_mcg_tarball",
)

sh_test(
    name = "smoke_test",
    size = "small",
    srcs = [
        "smoke_test.sh",
    ],
    data = [
        ":image_mcg_tarball",
    ],
    tags = [
        "manual",
        "no-sandbox",
    ],
)

shellcheck_test(
    name = "shellcheck_test",
    size = "small",
    data = [
        "smoke_test.sh",
    ],
    format = "gcc",
    severity = "style",
    tags = ["lint"],
)

# This test is a manual integration test that requires a running gcloud proxy.

sh_test(
    name = "vs_redis_curl_test",
    size = "small",
    srcs = [
        "vs_redis_curl_test.sh",
    ],
    args = [
        "$(location //mcg/testdata:vsignal_api/sample_ssot_ver1.json)",
        "$(location @jq_toolchains//:resolved_toolchain)",
    ],
    data = [
        "//mcg/testdata:vsignal_api/sample_ssot_ver1.json",
        "@jq_toolchains//:resolved_toolchain",
    ],
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)

shellcheck_test(
    name = "vs_redis_curl_test_shellcheck",
    size = "small",
    data = [
        "vs_redis_curl_test.sh",
    ],
)
