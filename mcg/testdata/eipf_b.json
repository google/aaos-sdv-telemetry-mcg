{
  "triggers": [
    {
      "name": "periodic_5s",
      "periodic": {
        "period_ms": 5000
      }
    },
    {
      "name": "trip_state_trigger",
      "data": {
        "source_name": "trip_state_publisher"
      }
    },
    {
      "name": "trip_end",
      "conditional": {
        "triggers": [
          "trip_state_trigger"
        ],
        "condition_type": {
					"is_true": {}
				},
        "expression": "trip_state_publisher.trip_end"
      }
    }
  ],
  "stop_trigger_name": "trip_end",
  "start_trigger_name": "periodic_5s",
  "data_sources": [
    {
      "name": "trip_state_publisher",
      "source_identifier": "TripState",
      "sub_sampling_interval_ms": 1500
    },
    {
      "name": "speed",
      "source_identifier": "VehicleSpeedPublisher"
    },
    {
      "name": "speed_with_config",
      "source_identifier": "VehicleSpeedPublisher",
      "configuration": {
        "type_url": "type.example.com/VideoConfiguration",
        "value": "CAE="
      }
    }
  ],
  "aggregators": [
    {
      "name": "max_meters_per_hour",
      "trigger_names": [
        "periodic_5s"
      ],
      "reset_on_get": true,
      "message_builder": {
        "message_type": ".google.protobuf.UInt32Value",
        "field_assignments": [
          {
            "field_name": "value",
            "aggregation": {
              "@type": "max",
              "expression": "speed.value"
            }
          }
        ]
      }
    },
    {
      "name": "avg_meters_per_hour",
      "trigger_names": [
        "periodic_5s"
      ],
      "reset_on_get": true,
      "message_builder": {
        "message_type": ".google.protobuf.FloatValue",
        "field_assignments": [
          {
            "field_name": "value",
            "aggregation": {
              "@type": "avg",
              "expression": "speed.value"
            }
          }
        ]
      }
    }
  ],
  "report_configs": [
    {
      "name": "max_avg_cur",
      "trigger_names": [
        "trip_end"
      ],
      "report_incomplete": true,
      "message_builder": {
        "message_type": ".android.sdv.telemetry.mcg.testdata.MaxAvgCur",
        "field_assignments": [
          {
            "field_name": "avg_meters_per_hour",
            "aggregation": {
              "@type": "none",
              "expression": "avg_meters_per_hour.value"
            }
          },
          {
            "field_name": "max_meters_per_hour",
            "aggregation": {
              "@type": "none",
              "expression": "max_meters_per_hour.value"
            }
          },
          {
            "field_name": "cur_meters_per_hour",
            "aggregation": {
              "@type": "none",
              "expression": "speed_with_config.value"
            }
          }
        ]
      }
    }
  ],
  "descriptor_protos": [
    ""
  ],
  "vehicle_signals": ""
}
