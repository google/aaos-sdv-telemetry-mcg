descriptor_protos {
  name: "test.proto"
  message_type {
    name: "TestMessage"
    field {
      name: "sources"
      type: TYPE_STRING
    }
    field {
      name: "stop_trigger_name"
      type: TYPE_STRING
    }
    field {
      name: "source_name"
      type: TYPE_STRING
    }
  }
  enum_type {
    name: "TestEnum"
    value {
      name: "ON_DEMAND"
      number: 0
    }
  }
}
triggers {
  name: "my_trigger"
  data_trigger {
    publisher_name: "my_source"
  }
}
publishers {
  name: "my_source"
  service_publisher {
    service_name: "my_service"
    connection_type: GETTER
  }
}
publishers {
  name: "my_aggregator"
  aggregation_publisher {
    trigger_names: "my_trigger"
    message_builder {
      message_type: ".google.protobuf.UInt32Value"
      field_assignments {
        field_name: "value"
        no_aggregation {
          expression_node_index: 0
        }
      }
    }
  }
}
# Expression Node 0
expression_nodes {
  field_leaf_node {
    publisher_name: "my_source"
    field_names: "a"
  }
}
end_trigger_name: "my_trigger"
finish_trigger_name: "my_trigger"
retain_aggregations_on_stop: true
