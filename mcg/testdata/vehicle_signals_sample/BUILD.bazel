    srcs = [
        "report/sample_speed_report.proto",
        "sdv_protos/reflection/message_metadata.proto",
        "sdv_protos/syntax/diagnostics.proto",
        "sdv_protos/syntax/runtime_config.proto",
        "sdv_protos/syntax/someip.proto",
        "sdv_protos/syntax/someip_type.proto",
        "sdv_protos/syntax/vsidl.proto",
        "signals_message.proto",
        "specific_speed.proto",
        "subpkg/sample_speed.proto",
        "subpkg/sample_speed_list.proto",
        "subpkg/sample_trigger.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@protobuf_src//:descriptor_proto",
    ],
)
