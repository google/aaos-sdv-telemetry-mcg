version: 3758096386

descriptor_protos {
  name: "adhoc.proto"
  package: "aaos.sdv.telemetry.adhoc"
  message_type {
    name: "aggregator"
    field {
      name: "data"
      number: 1
      type: TYPE_UINT64
    }
  }
  syntax: "proto2"
}
triggers {
  name: "some_trigger"
  periodic_trigger {
    interval {
      seconds: 1
      nanos: 200000000
    }
  }
}
sources {
  name: "data_source"
  data_source {
    source_identifier: "AServiceName::FRONT_LEFT"
    connection_type: SUBSCRIPTION
  }
}
sources {
  name: "aggregator"
  aggregator {
    trigger_names: "some_trigger"
    message_builder {
      message_type: ".aaos.sdv.telemetry.adhoc.aggregator"
      field_assignments {
        field_name: "data"
        no_aggregation {
          expression_node_index: 0
        }
      }
    }
  }
}
expression_nodes {
  field_leaf_node {
    source_name: "data_source"
    field_names: "value"
  }
}
start_trigger_name: "some_trigger"
stop_trigger_name: "some_trigger"
