version: 3758096386
descriptor_protos {
  name: "adhoc.proto"
  package: "aaos.sdv.telemetry.adhoc"
  dependency: "google/protobuf/any.proto"
  dependency: "mcg/testdata/vehicle_signals_sample/subpkg/sample_speed.proto"
  message_type {
    name: "aggregations"
    field {
      name: "none_meters_per_hour"
      number: 1
      type: TYPE_DOUBLE
    }
    field {
      name: "vector_meters_per_hour"
      number: 2
      type: TYPE_DOUBLE
      label: LABEL_REPEATED
    }
    field {
      name: "max_meters_per_hour"
      number: 3
      type: TYPE_DOUBLE
    }
    field {
      name: "min_meters_per_hour"
      number: 4
      type: TYPE_INT32
    }
    field {
      name: "avg_meters_per_hour"
      number: 5
      type: TYPE_DOUBLE
    }
    field {
      name: "count_meters_per_hour"
      number: 6
      type: TYPE_INT32
    }
    field {
      name: "sum_meters_per_hour"
      number: 7
      type: TYPE_INT32
    }
    field {
      name: "stddev_meters_per_hour"
      number: 8
      type: TYPE_DOUBLE
    }
    field {
      name: "delta_meters_per_hour"
      number: 9
      type: TYPE_INT32
    }
  }
  message_type {
    name: "max_avg_cur"
    field {
      name: "avg_meters_per_hour_rep"
      number: 1
      type: TYPE_DOUBLE
    }
    field {
      name: "max_meters_per_hour_rep"
      number: 2
      type: TYPE_DOUBLE
    }
    field {
      name: "cur_meters_per_hour_rep"
      number: 3
      type: TYPE_FLOAT
    }
    field {
      name: "min_meters_per_hour_rep"
      number: 4
      type: TYPE_INT32
    }
    field {
      name: "speed_msg_list"
      number: 5
      label: LABEL_REPEATED
      type: TYPE_MESSAGE
      type_name: ".google.protobuf.Any"
    }
    field {
      name: "speed_enum_field"
      number: 6
      type: TYPE_ENUM
      type_name: ".mcg.test.subpkg.speed_unit"
    }
    field {
      name: "source_without_field_specified"
      number: 7
      type: TYPE_MESSAGE
      type_name: ".google.protobuf.Any"
    }
  }
  syntax: "proto2"
}

descriptor_protos {
  name: "mcg/testdata/vehicle_signals_sample/subpkg/sample_speed.proto"
  package: "mcg.test.subpkg"
  enum_type {
    name: "speed_unit"
    value {
      name: "METRIC"
      number: 0
    }
    value {
      name: "IMPERIAL"
      number: 1
    }
    value {
      name: "RPM"
      number: 2
    }
  }
  syntax: "proto3"
}

triggers {
  name: "periodic_5s"
  periodic_trigger {
    interval {
      seconds: 5
    }
  }
}
triggers {
  name: "trip_end"
  conditional_trigger {
    trigger_names: "trip_state_trigger"
    selector_node_index: 0
    is_true {}
  }
}
triggers {
  name: "trip_state_trigger"
  data_trigger {
    source_name: "trip_state_publisher"
  }
}
sources {
  name: "aggregations"
  aggregator {
    trigger_names: "periodic_5s"
    reset_on_get: true
    message_builder {
      message_type: ".aaos.sdv.telemetry.adhoc.aggregations"
      field_assignments {
        field_name: "none_meters_per_hour"
        no_aggregation {
          expression_node_index: 1
        }
      }
      field_assignments {
        field_name: "vector_meters_per_hour"
        vector_aggregation {
          expression_node_index: 1
        }
      }
      field_assignments {
        field_name: "max_meters_per_hour"
        max_aggregation {
          expression_node_index: 1
        }
      }
      field_assignments {
        field_name: "min_meters_per_hour"
        min_aggregation {
          expression_node_index: 2
        }
      }
      field_assignments {
        field_name: "avg_meters_per_hour"
        avg_aggregation {
          expression_node_index: 2
        }
      }
      field_assignments {
        field_name: "count_meters_per_hour"
        count_aggregation {}
      }
      field_assignments {
        field_name: "sum_meters_per_hour"
        sum_aggregation {
          expression_node_index: 2
        }
      }
      field_assignments {
        field_name: "stddev_meters_per_hour"
        std_dev_aggregation {
          expression_node_index: 2
        }
      }
      field_assignments {
        field_name: "delta_meters_per_hour"
        delta_aggregation {
          expression_node_index: 2
        }
      }
    }
  }
}
sources {
  name: "speed"
  data_source {
    source_identifier: ".mcg.test.car_speed_msg"
    connection_type: SUBSCRIPTION
  }
}
sources {
  name: "speed_report"
  data_source {
    source_identifier: ".mcg.test.report.speed_report"
    connection_type: SUBSCRIPTION
  }
}
sources {
  name: "trip_state_publisher"
  data_source {
    source_identifier: ".mcg.test.subpkg.trigger_msg"
    connection_type: SUBSCRIPTION
  }
}
