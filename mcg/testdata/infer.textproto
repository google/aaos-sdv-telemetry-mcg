metrics_report_configs {
  name: "max_avg_cur"
  trigger_names: "trip_end"
  report_incomplete: true
  message_builder {
    message_type: ".aaos.sdv.telemetry.adhoc.max_avg_cur"
    field_assignments {
      field_name: "avg_meters_per_hour_rep"
      no_aggregation {
        expression_node_index: 5
      }
    }
    field_assignments {
      field_name: "max_meters_per_hour_rep"
      no_aggregation {
        expression_node_index: 6
      }
    }
    field_assignments {
      field_name: "cur_meters_per_hour_rep"
      no_aggregation {
        expression_node_index: 7
      }
    }
    field_assignments {
      field_name: "min_meters_per_hour_rep"
      no_aggregation {
        expression_node_index: 8
      }
    }
    field_assignments {
      field_name: "speed_msg_list"
      no_aggregation {
        expression_node_index: 9
      }
    }
    field_assignments {
      field_name: "speed_enum_field"
      no_aggregation {
        expression_node_index: 10
      }
    }
    field_assignments {
      field_name: "source_without_field_specified"
      no_aggregation {
        expression_node_index: 11
      }
    }
  }
}
