version: 3758096386
descriptor_protos {
  name: "mcg/testdata/maxavgcur/maxavgcur.proto"
  package: "android.sdv.telemetry.mcg.testdata"
  message_type {
    name: "MaxAvgCur"
    field {
      name: "max_meters_per_hour"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_UINT32
      json_name: "maxMetersPerHour"
    }
    field {
      name: "cur_meters_per_hour"
      number: 2
      label: LABEL_OPTIONAL
      type: TYPE_UINT32
      json_name: "curMetersPerHour"
    }
    field {
      name: "avg_meters_per_hour"
      number: 3
      label: LABEL_OPTIONAL
      type: TYPE_FLOAT
      json_name: "avgMetersPerHour"
    }
  }
  syntax: "proto3"
}
triggers {
  name: "periodic_5s"
  periodic_trigger {
    interval {
      seconds: 5
    }
  }
}
triggers {
  name: "trip_end"
  conditional_trigger {
    trigger_names: "trip_state_trigger"
    selector_node_index: 0
    is_true {}
  }
}
triggers {
  name: "trip_state_trigger"
  data_trigger {
    source_name: "trip_state_publisher"
  }
}
sources {
  name: "avg_meters_per_hour"
  aggregator {
    trigger_names: "periodic_5s"
    reset_on_get: true
    message_builder {
      message_type: ".google.protobuf.FloatValue"
      field_assignments {
        field_name: "value"
        avg_aggregation {
          expression_node_index: 1
        }
      }
    }
  }
}
sources {
  name: "max_meters_per_hour"
  aggregator {
    trigger_names: "periodic_5s"
    reset_on_get: true
    message_builder {
      message_type: ".google.protobuf.UInt32Value"
      field_assignments {
        field_name: "value"
        max_aggregation {
          expression_node_index: 1
        }
      }
    }
  }
}
sources {
  name: "speed"
  data_source {
    source_identifier: "VehicleSpeedPublisher"
    connection_type: SUBSCRIPTION
  }
}
sources {
  name: "speed_with_config"
  data_source {
    source_identifier: "VehicleSpeedPublisher"
    connection_type: SUBSCRIPTION
    configuration {
      type_url: "type.example.com/VideoConfiguration"
      value: "\x08\x01"
    }
  }
}
sources {
  name: "trip_state_publisher"
  data_source {
    source_identifier: "TripState"
    connection_type: SUBSCRIPTION
    sub_sampling_interval {
      seconds: 1
      nanos: 500000000
    }
  }
}
expression_nodes {
  field_leaf_node {
    source_name: "trip_state_publisher"
    field_names: "trip_end"
  }
}
expression_nodes {
  field_leaf_node {
    source_name: "speed"
    field_names: "value"
  }
}
expression_nodes {
  field_leaf_node {
    source_name: "avg_meters_per_hour"
    field_names: "value"
  }
}
expression_nodes {
  field_leaf_node {
    source_name: "max_meters_per_hour"
    field_names: "value"
  }
}
expression_nodes {
  field_leaf_node {
    source_name: "speed_with_config"
    field_names: "value"
  }
}
metrics_report_configs {
  name: "max_avg_cur"
  trigger_names: "trip_end"
  report_incomplete: true
  message_builder {
    message_type: ".android.sdv.telemetry.mcg.testdata.MaxAvgCur"
    field_assignments {
      field_name: "avg_meters_per_hour"
      no_aggregation {
        expression_node_index: 2
      }
    }
    field_assignments {
      field_name: "max_meters_per_hour"
      no_aggregation {
        expression_node_index: 3
      }
    }
    field_assignments {
      field_name: "cur_meters_per_hour"
      no_aggregation {
        expression_node_index: 4
      }
    }
  }
}
start_trigger_name: "periodic_5s"
stop_trigger_name: "trip_end"
