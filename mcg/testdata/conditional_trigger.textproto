version: 3758096386
expression_nodes {
  constant_leaf_node {
    bool_value: true
  }
}
stop_trigger_name: "parent_trigger"
start_trigger_name: "parent_trigger"
triggers {
  name: "parent_trigger"
  periodic_trigger {
    interval {
      seconds: 1
      nanos: 200000000
    }
  }
}

triggers {
  name: "is_true"
  conditional_trigger {
    trigger_names: "parent_trigger"
    selector_node_index: 0
    is_true {
    }
  }
}

triggers {
  name: "is_false"
  conditional_trigger {
    trigger_names: "parent_trigger"
    selector_node_index: 0
    is_false {
    }
  }
}

triggers {
  name: "rising_edge"
  conditional_trigger {
    trigger_names: "parent_trigger"
    selector_node_index: 0
    rising_edge {
    }
  }
}
triggers {
  name: "rising_edge_empty_edge_options"
  conditional_trigger {
    trigger_names: "parent_trigger"
    selector_node_index: 0
    rising_edge {
      rising_options {
        min_duration {
        }
      }
    }
  }
}
triggers {
  name: "rising_edge_edge_options_1"
  conditional_trigger {
    trigger_names: "parent_trigger"
    selector_node_index: 0
    rising_edge {
      rising_options {
        min_duration {
          nanos: 123000000
        }
      }
    }
  }
}
triggers {
  name: "rising_edge_edge_options_2"
