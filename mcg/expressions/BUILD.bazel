    name = "expressions_test",
    size = "small",
    srcs = ["parse_test.go"],
    deps = [
        ":expressions",
        "//third_party/aosp/sdv/telemetry/metrics_configuration:telemetry_go_proto",
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
