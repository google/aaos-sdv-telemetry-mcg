load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "expressions",
    srcs = [
        "helpers.go",
        "parse.go",
    ],
    importpath = "sdv.googlesource.com/mcg/mcg/expressions",
    visibility = ["//visibility:public"],
