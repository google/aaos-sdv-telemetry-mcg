load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "vs_cache",
    srcs = [
        "vs_cache.go",
        "vs_cache_local.go",
        "vs_cache_redis.go",
    ],
    importpath = "sdv.googlesource.com/mcg/mcg/vs_cache",
    visibility = ["//visibility:public"],
    deps = [
        "//mcg/errors",
        "//mcg/type_resolvers",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_test(
    name = "vs_cache_test",
    size = "small",
    srcs = ["vs_cache_test.go"],
    data = [
        "//mcg/testdata:exported_testdata",
    ],
    race = "on",
    deps = [
        ":vs_cache",
        "//mcg/testhelper",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

go_test(
    name = "vs_cache_integration_test",
    size = "small",
    srcs = ["vs_cache_redis_test.go"],
    data = [
        "//mcg/testdata:exported_testdata",
    ],
    tags = [
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":vs_cache",
        "//mcg/testhelper",
        "@com_github_cenkalti_backoff//:backoff",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_ory_dockertest//:dockertest",
        "@com_github_ory_dockertest//docker",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)
