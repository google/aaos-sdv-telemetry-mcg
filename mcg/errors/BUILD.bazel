load("@protobuf_src//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

# gazelle:proto package
# gazelle:resolve proto google/rpc/code.proto @googleapis//google/rpc:code_proto
# gazelle:resolve proto go google/rpc/code.proto @org_golang_google_genproto_googleapis_rpc//code

proto_library(
    name = "http_error_proto",
    srcs = ["http_error.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@googleapis//google/rpc:code_proto",
        "@protobuf_src//:any_proto",
    ],
)

go_proto_library(
    name = "http_error_go_proto",
    compilers = ["//:go_proto_compiler"],
    importpath = "sdv.googlesource.com/mcg/mcg/errors",
    proto = ":http_error_proto",
    visibility = ["//visibility:public"],
    deps = ["@org_golang_google_genproto_googleapis_rpc//code"],
)

go_library(
    name = "errors",
    srcs = [
        "constructors.go",
        "doc.go",
        "errors.go",
        "validation_errors.go",
    ],
    embed = [":http_error_go_proto"],
    importpath = "sdv.googlesource.com/mcg/mcg/errors",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_gin_gonic_gin//binding",
        "@org_golang_google_genproto_googleapis_rpc//code",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/anypb",
    ],
)

go_test(
    name = "errors_test",
    size = "small",
    srcs = [
        "errors_test.go",
        "export_test.go",
    ],
    embed = [":errors"],
    deps = [
        "@org_golang_google_genproto_googleapis_rpc//code",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)
