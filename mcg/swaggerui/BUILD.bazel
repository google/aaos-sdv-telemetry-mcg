load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_go//go:def.bzl", "go_library", "go_test")

copy_to_directory(
    name = "dist",
    srcs = [
        # These are the static files for the Swagger UI.
        "@swagger_ui",
        # This is our custom initializer file that configures MCG-specific Swagger
        # options.
        "swagger-initializer.js",
    ],
    out = "dist",
    add_directory_to_runfiles = False,
    include_external_repositories = ["**"],
)

go_library(
    name = "swaggerui",
    srcs = ["swaggerui.go"],
    embedsrcs = ["dist"],
    importpath = "sdv.googlesource.com/mcg/mcg/swaggerui",
    visibility = ["//visibility:public"],
)

go_test(
    name = "swaggerui_test",
    size = "small",
    srcs = ["swaggerui_test.go"],
    deps = [":swaggerui"],
)
