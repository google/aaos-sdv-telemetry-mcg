load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "validators",
    srcs = [
        "doc.go",
        "graph_factory.go",
        "mc_validator.go",
        "shallow_validators.go",
    ],
    importpath = "sdv.googlesource.com/mcg/mcg/validators",
    visibility = ["//visibility:public"],
    deps = [
        "//mcg/errors",
        "//mcg/expressions",
        "//mcg/graph",
        "//mcg/mcuuid",
        "//mcg/session",
        "//mcg/type_resolvers",
        "//third_party/aosp/sdv/telemetry/metrics_configuration:telemetry_go_proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

go_test(
    name = "validators_test",
    size = "small",
    srcs = [
        "export_test.go",
        "mc_validator_test.go",
        "shallow_validator_test.go",
    ],
    data = [
        "//mcg/testdata:exported_testdata",
    ],
    embed = [":validators"],
    deps = [
        "//mcg/constants",
        "//mcg/errors",
        "//mcg/session",
        "//third_party/aosp/sdv/telemetry/metrics_configuration:telemetry_go_proto",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)
