    x_defs = {
        "VERSION": module_version(),
    },
    deps = [
        "//mcg/constants",
        "//mcg/errors",
        "//mcg/expressions",
        "//mcg/inference",
        "//mcg/mcuuid",
        "//mcg/requests",
        "//mcg/session",
        "//mcg/signal_versions",
        "//mcg/validators",
        "//third_party/aosp/sdv/telemetry/metrics_configuration:telemetry_go_proto",
