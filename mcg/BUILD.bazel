        "//mcg/type_resolvers",
        "//mcg/vs_cache",
        "//third_party/aosp/sdv/telemetry/metrics_configuration:telemetry_go_proto",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_google_go_cmp//cmp",
